opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_jane"
bug-reports: "https://github.com/public-release-reloaded/ppx_jane/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_jane.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_jane/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base_quickcheck" {>= "v0.18~" & < "v0.19~"}
  "ppx_assert" {>= "v0.18~" & < "v0.19~"}
  "ppx_base" {>= "v0.18~" & < "v0.19~"}
  "ppx_bench" {>= "v0.18~" & < "v0.19~"}
  "ppx_bin_prot" {>= "v0.18~" & < "v0.19~"}
  "ppx_custom_printf" {>= "v0.18~" & < "v0.19~"}
  "ppx_debug_assert" {>= "v0.18~" & < "v0.19~"}
  "ppx_disable_unused_warnings" {>= "v0.18~" & < "v0.19~"}
  "ppx_expect" {>= "v0.18~" & < "v0.19~"}
  "ppx_fields_conv" {>= "v0.18~" & < "v0.19~"}
  "ppx_fixed_literal" {>= "v0.18~" & < "v0.19~"}
  "ppx_here" {>= "v0.18~" & < "v0.19~"}
  "ppx_ignore_instrumentation" {>= "v0.18~" & < "v0.19~"}
  "ppx_inline_test" {>= "v0.18~" & < "v0.19~"}
  "ppx_int63_literal" {>= "v0.18~" & < "v0.19~"}
  "ppx_let" {>= "v0.18~" & < "v0.19~"}
  "ppx_log" {>= "v0.18~" & < "v0.19~"}
  "ppx_module_timer" {>= "v0.18~" & < "v0.19~"}
  "ppx_optional" {>= "v0.18~" & < "v0.19~"}
  "ppx_pipebang" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_message" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_value" {>= "v0.18~" & < "v0.19~"}
  "ppx_shorthand" {>= "v0.18~" & < "v0.19~"}
  "ppx_stable" {>= "v0.18~" & < "v0.19~"}
  "ppx_stable_witness" {>= "v0.18~" & < "v0.19~"}
  "ppx_string" {>= "v0.18~" & < "v0.19~"}
  "ppx_string_conv" {>= "v0.18~" & < "v0.19~"}
  "ppx_template" {>= "v0.18~" & < "v0.19~"}
  "ppx_tydi" {>= "v0.18~" & < "v0.19~"}
  "ppx_typed_fields" {>= "v0.18~" & < "v0.19~"}
  "ppx_typerep_conv" {>= "v0.18~" & < "v0.19~"}
  "ppx_var_name" {>= "v0.18~" & < "v0.19~"}
  "ppx_variants_conv" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {> "0.38.0"}
]
available: arch != "x86_32"
synopsis: "Standard Jane Street ppx rewriters"
description: "
This package installs a ppx-jane executable, which is a ppx driver
including all standard Jane Street ppx rewriters.
"
